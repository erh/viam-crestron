{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "erh:crestron",
  "visibility": "public",
  "url": "https://github.com/erh/viam-crestron/",
  "description": "Control Crestron Home lights (switches) and scenes (buttons) via /cws/api, with a shared controller and a discovery service.",
  "models": [
    {
      "api": "rdk:component:generic",
      "model": "erh:crestron:controller",
      "markdown_link": "README.md#controller"
    },
    {
      "api": "rdk:component:switch",
      "model": "erh:crestron:light",
      "markdown_link": "README.md#light"
    },
    {
      "api": "rdk:component:button",
      "model": "erh:crestron:scene",
      "markdown_link": "README.md#scene"
    },
    {
      "api": "rdk:service:discovery",
      "model": "erh:crestron:discovery",
      "markdown_link": "README.md#discovery"
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/crestron-module",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64"
    ]
  }
}
